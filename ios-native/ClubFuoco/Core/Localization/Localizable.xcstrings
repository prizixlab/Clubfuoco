    "location.nearby.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the best clubs near you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra los mejores clubs cerca de ti"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Troba els millors clubs a prop teu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez les meilleurs clubs près de vous"
          }
        }
      }
    },
    "location.nearby.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location and we'll show the clubs closest to you tonight, sorted by how far they are from where you're standing. Used only while you have the app open — never in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la ubicación y te mostraremos los clubs más cercanos esta noche, ordenados por la distancia desde donde estés. Solo se usa con la app abierta — nunca en segundo plano."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la ubicació i et mostrarem els clubs més propers aquesta nit, ordenats per la distància des d'on ets. Només s'usa amb l'app oberta — mai en segon pla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la localisation et nous vous montrerons les clubs les plus proches ce soir, triés par distance depuis votre position. Utilisée uniquement quand l'app est ouverte — jamais en arrière-plan."
          }
        }
      }
    },
    "location.nearby.enable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show clubs near me"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar clubs cerca de mí"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra clubs a prop meu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les clubs près de moi"
          }
        }
      }
    },
    "location.nearby.tip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When iOS asks, tap **Allow While Using App**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando iOS pregunte, toca **Permitir al usar la app**."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan iOS ho demani, toca **Permet mentre s'usa l'app**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand iOS vous le demande, appuyez sur **Autoriser lorsque l'app est active**."
          }
        }
      }
    },
    "location.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check you in automatically"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te registramos automáticamente"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra't automàticament"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement automatique"
          }
        }
      }
    },
    "location.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the night of your booking we draw a small circle around the venue. When you arrive, your pass updates — and nothing else. No background tracking, no map history, nothing between nights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La noche de tu reserva trazamos un pequeño círculo alrededor del local. Cuando llegas, tu pase se actualiza — y nada más. Sin rastreo en segundo plano, sin historial de mapa, nada entre noches."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La nit de la teva reserva dibuixem un cercle petit al voltant del local. Quan hi arribes, el teu pase s'actualitza — i res més. Sense rastreig en segon pla, sense historial de mapa, res entre nits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir de votre réservation, nous traçons un petit cercle autour du lieu. À votre arrivée, votre pass se met à jour — et rien d'autre. Aucun suivi en arrière-plan, aucun historique de carte, rien entre les soirées."
          }
        }
      }
    },
    "location.stepsHeader": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS will show two prompts:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS mostrará dos diálogos:"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS mostrarà dos diàlegs:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS affichera deux demandes :"
          }
        }
      }
    },
    "location.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap **Allow While Using App**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca **Permitir al usar la app**"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca **Permet mentre s'usa l'app**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur **Autoriser lorsque l'app est active**"
          }
        }
      }
    },
    "location.step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then tap **Change to Always Allow**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después toca **Cambiar a Permitir siempre**"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després toca **Canvia a Permet sempre**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis appuyez sur **Toujours autoriser**"
          }
        }
      }
    },
    "location.enable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable arrival check-in"
