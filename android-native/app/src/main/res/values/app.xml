    <!-- ── Location ladder, Android wording ─────────────────────────────────
         The catalog's location_* step copy names Apple's buttons ("Allow While
         Using App", "Change to Always Allow") and says "when iOS asks". Android
         has different buttons AND a different shape: from API 30 the background
         grant can only be given in Settings, so there is no second in-app
         dialog to describe. These replace the step strings only — the titles
         and bodies are platform-neutral and come from the catalog. -->
    <string name="location_androidNearbyTip">When Android asks, tap **While using the app**.</string>
    <string name="location_androidStep1">Tap **While using the app**</string>
    <string name="location_androidStep2">Then choose **Allow all the time** in Settings</string>
    <string name="location_androidSettingsBody">Android only lets you turn this on from Settings. It takes three taps.</string>
    <string name="location_androidSettingsStep1">Tap **Open Settings** below</string>
    <string name="location_androidSettingsStep2">Tap **Permissions**, then **Location**</string>
    <string name="location_androidSettingsStep3">Choose **Allow all the time**</string>

