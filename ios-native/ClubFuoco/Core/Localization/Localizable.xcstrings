    "settings.arrivalFooter": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa la Ubicació a \"Sempre\" per registrar-te automàticament la nit d'una reserva. Només escoltem al local, només aquella nit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Location to \"Always\" to check you in automatically the night of a booking. We only listen at the venue, only on the night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon Ubicación en \"Siempre\" para registrarte automáticamente la noche de una reserva. Solo escuchamos en el local, solo esa noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez la Localisation sur « Toujours » pour vous enregistrer automatiquement le soir d'une réservation. Nous n'écoutons qu'au lieu, uniquement ce soir-là."
          }
        }
      }
    },
