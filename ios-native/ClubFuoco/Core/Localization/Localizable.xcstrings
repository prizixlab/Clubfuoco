  "version": "1.0",
  "strings": {
    "splash.tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the night begins before you arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde la noche empieza antes de que llegues."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "On la nit comença abans que hi arribis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là où la nuit commence avant votre arrivée."
          }
        }
      }
    },
