    "signup.clubArtistNotOpen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club and artist accounts aren't open yet — these features are coming soon. For now, continue as a guest and explore the city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas de local y artista aún no están abiertas — estas funciones llegarán pronto. Por ahora, continúa como invitado y explora la ciudad."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els comptes de club i d'artista encara no estan oberts — arriben ben aviat. De moment, continua com a convidat i explora la ciutat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes club et artiste ne sont pas encore ouverts — ces fonctionnalités arrivent bientôt. Pour l'instant, continuez en invité et explorez la ville."
          }
        }
      }
    },
    "signup.justNightsOut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "← I'm just here for nights out"
