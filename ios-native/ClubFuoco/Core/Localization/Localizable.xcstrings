    "location.nearby.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the best clubs near you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra los mejores clubs cerca de ti"
          }
        }
      }
    },
    "location.nearby.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location and we'll show the clubs closest to you tonight, sorted by how far they are from where you're standing. Used only while you have the app open — never in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la ubicación y te mostraremos los clubs más cercanos esta noche, ordenados por la distancia desde donde estés. Solo se usa con la app abierta — nunca en segundo plano."
          }
        }
      }
    },
    "location.nearby.enable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show clubs near me"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar clubs cerca de mí"
          }
        }
      }
    },
    "location.nearby.tip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When iOS asks, tap **Allow While Using App**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando iOS pregunte, toca **Permitir al usar la app**."
          }
        }
      }
    },
    "location.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check you in automatically"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te registramos automáticamente"
          }
        }
      }
    },
    "location.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the night of your booking we draw a small circle around the venue. When you arrive, your pass updates — and nothing else. No background tracking, no map history, nothing between nights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La noche de tu reserva trazamos un pequeño círculo alrededor del local. Cuando llegas, tu pase se actualiza — y nada más. Sin rastreo en segundo plano, sin historial de mapa, nada entre noches."
          }
        }
      }
    },
    "location.stepsHeader": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS will show two prompts:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS mostrará dos diálogos:"
          }
        }
      }
    },
    "location.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap **Allow While Using App**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca **Permitir al usar la app**"
          }
        }
      }
    },
    "location.step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then tap **Change to Always Allow**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después toca **Cambiar a Permitir siempre**"
          }
        }
      }
    },
