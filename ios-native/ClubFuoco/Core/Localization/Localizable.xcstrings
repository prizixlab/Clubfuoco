    },
    "location.nearby.body": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la ubicació i et mostrarem els clubs més propers aquesta nit, ordenats per la distància des d'on siguis. Només s'usa amb l'app oberta — mai en segon pla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location and we'll show the clubs closest to you tonight, sorted by how far they are from where you're standing. Used only while you have the app open — never in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la ubicación y te mostraremos los clubs más cercanos esta noche, ordenados por la distancia desde donde estés. Solo se usa con la app abierta — nunca en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la localisation et nous vous montrerons les clubs les plus proches ce soir, triés selon leur distance par rapport à vous. Utilisé uniquement quand l'app est ouverte — jamais en arrière-plan."
          }
        }
      }
    },
    "location.nearby.enable": {
