          "stringUnit": {
            "state": "translated",
            "value": "Les places de pagament necessiten pagament a l'app — arriba aviat. De moment, fes servir l'enllaç d'invitació al web."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid spots need in-app payment — coming later this phase. Use the invite link on the web for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plazas de pago necesitan pago en la app — llega pronto. De momento usa el enlace de invitación en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les places payantes nécessitent un paiement dans l'app — bientôt disponible. Pour l'instant, utilisez le lien d'invitation sur le web."
          }
        }
      }
    },
