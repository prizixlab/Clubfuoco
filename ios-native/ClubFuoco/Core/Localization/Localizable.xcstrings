    "splash.guestNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse everything without an account. You only share details when you book."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora todo sin cuenta. Solo compartes datos cuando reservas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora-ho tot sense compte. Només comparteixes dades quan reserves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez tout sans compte. Vous ne partagez vos données qu'au moment de réserver."
          }
        }
      }
    },
    "splash.termsNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing you accept the terms & privacy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar aceptas los términos y la privacidad"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuar, acceptes els termes i la privacitat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez les conditions et la confidentialité"
          }
        }
      }
    },
