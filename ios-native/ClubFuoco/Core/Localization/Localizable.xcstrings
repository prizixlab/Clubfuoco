    "help.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what’s wrong with this booking and we’ll come back to you by email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué pasa con esta reserva y te responderemos por email."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica'ns què passa amb aquesta reserva i et respondrem per correu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous ce qui ne va pas avec cette réservation et nous vous répondrons par e-mail."
          }
        }
      }
    },
    "help.urgent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the door right now?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás en la puerta?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ets a la porta ara mateix?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à l'entrée ?"
          }
        }
      }
    },
    "help.urgentBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your pass to the door team — they can look you up by the reference below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enseña tu pase en puerta — pueden buscarte con la referencia de abajo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensenya el teu pase a l'equip de porta — et poden buscar amb la referència de sota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrez votre pass à l'équipe d'entrée — ils peuvent vous retrouver avec la référence ci-dessous."
          }
        }
      }
    },
