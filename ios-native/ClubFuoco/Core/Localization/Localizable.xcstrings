    "completeProfile.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry — we didn't get everything we need from your sign-in. Just fill in the last details and you're in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdona — no recibimos todo lo necesario de tu inicio de sesión. Completa los últimos datos y estás dentro."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdona — no hem rebut tot el que necessitem del teu inici de sessió. Omple les últimes dades i ja estàs dins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désolé — nous n'avons pas tout reçu lors de votre connexion. Complétez ces derniers détails et c'est bon."
          }
        }
      }
    },
