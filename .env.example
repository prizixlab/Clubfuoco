# ============================================================
# CLUB FUOCO — Environment Variables
# Copy this file to .env.local and fill in your real values
# NEVER commit .env.local to git
# ============================================================

# ---- Supabase ------------------------------------------------
# Get these from: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Keep secret — server only

# ---- Stripe --------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
# Use TEST keys during development (sk_test_..., pk_test_...)

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Webhook secret — get from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
# For local dev, use: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs — create these in Stripe Dashboard → Products
# Gold membership: €19/month recurring
STRIPE_PRICE_GOLD=price_your-gold-price-id

# Sapphire membership: €49/month recurring
STRIPE_PRICE_SAPPHIRE=price_your-sapphire-price-id

# ---- App -----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fuoco Door — HMAC secret for signing night manifests (/api/door/manifest).
# Unset ⇒ manifests are emitted "unsigned" (dev). Set in prod to enforce.
DOOR_MANIFEST_SECRET=

# Comma-separated emails allowed to seed test bookings in production.
# Leave unset in any environment where nobody should be able to.
TEST_BOOKING_EMAILS=

# Investor gate (/investors) — LOCAL DEV ONLY.
# Set this to the access code to render a "Preview code — …" hint on the gate
# so you don't have to dig it out of an intro email. NEVER set it in
# production: the page also guards on NODE_ENV, but leaving it unset is the
# real safeguard. Real investors receive the code by email.
NEXT_PUBLIC_INVESTOR_PREVIEW_CODE=

# Investor gate (/investors) — SERVER-SIDE access code. Verified in
# POST /api/investors/unlock; never sent to the browser. Unset falls back to
# the historical FUOCO2026. Set and rotate this in production — changing it
# invalidates every unlock cookie already issued.
INVESTORS_ACCESS_CODE=
