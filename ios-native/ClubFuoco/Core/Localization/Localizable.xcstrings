    },
    "help.urgentBody": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Menciona aquesta referència si ens escrius sobre aquesta reserva."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quote this reference if you contact us about this booking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menciona esta referencia si nos escribes sobre esta reserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentionnez cette référence si vous nous contactez au sujet de cette réservation."
          }
        }
      }
    },
    "location.body": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La nit de la teva reserva dibuixem un petit cercle al voltant del local. Quan arribes, el teu pas s'actualitza — i res més. Sense rastreig en segon pla, sense historial de mapa, res entre nits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the night of your booking we draw a small circle around the venue. When you arrive, your pass updates — and nothing else. No background tracking, no map history, nothing between nights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La noche de tu reserva trazamos un pequeño círculo alrededor del local. Cuando llegas, tu pase se actualiza — y nada más. Sin rastreo en segundo plano, sin historial de mapa, nada entre noches."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir de votre réservation, nous traçons un petit cercle autour du lieu. À votre arrivée, votre pass se met à jour — et rien d'autre. Pas de suivi en arrière-plan, pas d'historique de carte, rien entre les soirées."
          }
        }
      }
    },
    "location.enable": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
